# Copy to .env and adjust as needed (used by docker-compose)
# All values are optional — sensible defaults are used when omitted.

# Behind an HTTPS reverse proxy (Nginx Proxy Manager, Traefik, Caddy…)?
TRUST_PROXY=0
# Number of trusted reverse-proxy hops when TRUST_PROXY=1 (default: 1).
# Set PUBLIC_URL explicitly when using a proxy; otherwise Host headers can
# influence OAuth/pairing URLs.
# TRUST_PROXY_HOPS=1
SECURE_COOKIES=0

# Canonical public URL — recommended for OAuth/OIDC behind a proxy.
# PUBLIC_URL=https://deck.example.com

# Session lifetimes (hours)
# SESSION_TTL_HOURS=168
# SESSION_TTL_REMEMBER_HOURS=720

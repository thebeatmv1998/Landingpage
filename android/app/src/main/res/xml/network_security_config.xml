<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      HomeDeck is often installed on a LAN and reached over plain HTTP
      (e.g. http://192.168.1.10:8080). Cleartext is allowed so the app works
      out of the box; the app warns when the configured server is not HTTPS.
      Use HTTPS (reverse proxy) whenever the server is reachable from the internet.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
